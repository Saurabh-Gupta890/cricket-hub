# 🏏 CricketHub Enterprise & Security Environment Configuration
# Copy this file to .env and configure your production credentials

NODE_ENV=production
PORT=3000

# CORS Whitelist (comma-separated origins or * for open)
CORS_ORIGIN=*

# Web Push Notifications (Auto-generated if omitted)
# VAPID_EMAIL=admin@yourcricketdomain.com
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key

# 🌐 Permanent Cloud Database (MongoDB Atlas Free / Dedicated Tier)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=crickethub

# 🔒 Configurable Rate Limiting & Backoff Thresholds (Never-Get-Hacked Architecture)
AUTH_RATE_LIMIT_MAX=6
AUTH_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
AUTHED_RATE_LIMIT_MAX=300
AUTHED_RATE_LIMIT_WINDOW_MS=60000
