# 🏏 CricketHub Production Environment Configuration Example
# Copy this file to .env and configure your production values

NODE_ENV=production
PORT=3000

# CORS Whitelist (comma-separated origins or * for all)
CORS_ORIGIN=*

# Web Push Notifications (Optional: generated automatically if omitted)
# VAPID_EMAIL=admin@yourcricketdomain.com
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key

# 🌐 Permanent Cloud Database (MongoDB Atlas Free Tier)
# If provided, all matches, users, groups, and rooms persist forever in the cloud.
# If omitted, the app automatically falls back to local data/*.json files.
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=crickethub
