# 🏏 CricketHub PRODUCTION Environment Configuration
# Strict security, real SMS gateways, hardened rate limits & production data store

NODE_ENV=production
PORT=3000
DATA_DIR=data

# CORS Whitelist (Set your production domain, e.g., https://crickethub.app)
CORS_ORIGIN=*

# Web Push Notifications (Production VAPID Keys)
# VAPID_EMAIL=admin@crickethub.app
# VAPID_PUBLIC_KEY=your_production_vapid_public_key
# VAPID_PRIVATE_KEY=your_production_vapid_private_key

# Production Cloud Database (MongoDB Atlas Dedicated/M0 Cluster)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=crickethub_production

# Enterprise Rate Limiting & Never-Get-Hacked Bruteforce Defense
AUTH_RATE_LIMIT_MAX=6
AUTH_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=100
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
AUTHED_RATE_LIMIT_MAX=300
AUTHED_RATE_LIMIT_WINDOW_MS=60000
