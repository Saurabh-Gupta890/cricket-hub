# 🏏 CricketHub STAGING QA Sandbox Environment Configuration
# Isolated sandbox for QA, feature branch testing, and automated E2E runs

NODE_ENV=staging
PORT=3001
DATA_DIR=data-staging

# CORS Whitelist (Open for staging testers and staging web domain)
CORS_ORIGIN=*

# Staging Database (Isolated Cloud MongoDB or Local JSON Sandbox)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=crickethub_staging

# Rate Limiting (Relaxed for QA automated testing suites)
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=300
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
AUTHED_RATE_LIMIT_MAX=600
AUTHED_RATE_LIMIT_WINDOW_MS=60000
