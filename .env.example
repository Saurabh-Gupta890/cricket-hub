# 🏏 CricketHub Production Environment Configuration Example
# Copy this file to .env and configure your production values

NODE_ENV=production
PORT=3000

# CORS Whitelist (comma-separated origins or * for all)
CORS_ORIGIN=*

# Web Push Notifications (Optional: generated automatically if omitted)
# VAPID_EMAIL=admin@yourcricketdomain.com
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
